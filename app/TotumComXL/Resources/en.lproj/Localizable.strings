"compare.confirm.deleteLeft" = "Move %d file(s) to the Trash in “%@”";
"compare.confirm.deleteRight" = "Move %d file(s) to the Trash in “%@”";
"compare.confirm.trashNote" = "Deleted files go to the Trash and can be put back.";
"compare.help.delete.title" = "Deleting a file";
"compare.help.delete.body" = "Keep clicking a row and after → and ← you reach the red bin: the side that loses the file is struck through in red, so you can see exactly which copy goes. Files are moved to the Trash, not erased — you can put them back. Click once more to reach “leave alone”. The right-click menu does the same. Nothing is deleted until you press Synchronize and confirm.";
"compare.help.exclude.title" = "Hiding files you do not care about";
"compare.help.exclude.body" = "Right-click a row and choose “Exclude from comparison” to drop it from the list. For whole groups use the second box in the toolbar — for example .DS_Store;*.tmp — and separate several masks with a semicolon.";
"compare.legend.delete" = "to Trash";
