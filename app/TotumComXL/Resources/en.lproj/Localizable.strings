"compare.confirm.moveLeft" = "Move %d file(s) to “%@” (removed from the source)";
"compare.help.move.title" = "Moving instead of copying";
"compare.help.move.body" = "An orange arrow with a little bin means the file travels to the other side and does NOT stay where it was — the source is struck through so you can see what it leaves behind. A plain green or blue arrow copies and keeps the original. Both are on the same click cycle, and both are in the right-click menu.";
"menu.help.guide" = "Totum Commander Help";
"help.search" = "Search help";
"help.noResults" = "Nothing in this topic matches.";
"checksum.help.intro" = "A checksum is a short string calculated from the whole contents of a file. Two files with the same checksum are the same file; change one byte and the checksum changes completely.";
"checksum.help.what.title" = "What it is for";
"checksum.help.what.body" = "To be sure a file arrived intact. A download that broke half-way, a copy to a failing disk or a file someone edited will all produce a different checksum, even when the size looks right.";
"checksum.help.algorithms.title" = "MD5, SHA-1, SHA-256";
"checksum.help.algorithms.body" = "Three ways of calculating it. Use whichever the other side gives you — sites publish one of these next to their downloads. All three are worked out in a single pass over the file, so switching between them costs nothing.";
"checksum.help.verify.title" = "Checking against a published sum";
"checksum.help.verify.body" = "Paste the string from the web page into the Verify box. You get “Matches” or “Does not match” straight away, and it is compared against all three algorithms — so it does not matter which one the site used.";
"checksum.help.save.title" = "Saving to a file";
"checksum.help.save.body" = "Writes one “sum  filename” line per file, the layout md5sum and shasum expect, so the file can be checked later with the standard command-line tools or handed to someone else.";
"checksum.help.example.title" = "An example";
"checksum.help.example.body" = "You downloaded a disk image and the site shows a SHA-256 next to it. Put the cursor on the file, open Tools ▸ Checksums, paste the string into Verify. “Matches” means the download is intact.";
"monitor.help.intro" = "A live picture of what the machine is doing, shown inside a panel instead of a separate app.";
"monitor.help.tabs.title" = "The five tabs";
"monitor.help.tabs.body" = "CPU, Memory, Energy, Disk and Network. Each shows the totals at the top and the processes below, sorted by whatever that tab is about.";
"monitor.help.columns.title" = "Choosing columns";
"monitor.help.columns.body" = "Right-click the column headings to add or remove columns — 25 are available, and each tab remembers its own set. Click a heading to sort by it, click again to reverse.";
"monitor.help.actions.title" = "Acting on a process";
"monitor.help.actions.body" = "Select a row and use ✕ to quit it, or ⓘ for the full window with its path, parent, memory, kernel statistics and open files. Double-clicking a row opens the same window. The ⋯ menu holds force-quit, the row limit and how often everything refreshes.";
"monitor.help.limits.title" = "Why some processes show a dash";
"monitor.help.limits.body" = "macOS only lets an ordinary application measure processes belonging to you. Processes owned by root or another user are still listed with their name, PID and owner, but their CPU and memory read “—” — that data is not available without system privileges this app deliberately does not ask for.";
"design.tabActiveOpacity" = "Active tab opacity";
"design.tabActiveOpacity.hint" = "How solid the current tab is filled. The other tabs keep their lighter fill, so raising this makes the active one stand out more.";
"compare.help.summary.title" = "The bar along the bottom";
"compare.help.summary.body" = "It counts what the plan will do: how many go right, how many go left, how many move, how many go to the Trash, and how many are left alone. “Reset directions” throws away every arrow you changed by hand and puts the suggested ones back. If you hid rows, a link appears to bring them back too.";
"compare.help.paths.title" = "Which folder is which";
"compare.help.paths.body" = "The two paths sit right above the list, with a green dot for the left side and a blue dot for the right. The same colours are used by the arrows, so a green → always means “towards the blue folder”.";
"design.tabActiveTitleColor" = "Active tab text";
"design.tabActiveTitleColor.hint" = "Colour of the name and icons on the current tab. Stored separately for the light and dark themes; leave it unset to keep the ordinary text colour.";
