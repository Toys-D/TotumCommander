"join.result" = "Result";
"join.willVerify" = "A checksum file is here, so the result will be verified.";
"join.noChecksum" = "There is no checksum file, so the result cannot be verified.";
"join.deleteParts" = "Move the parts to the Trash afterwards";
"join.deleteParts.hint" = "Only once the checksum confirms the result is intact. If it does not match, the parts are kept.";
"join.deleteParts.hintUnverified" = "Without a checksum there is no way to prove the result is complete. The parts go to the Trash and can be put back, but check the joined file opens before emptying it.";
"join.partsTrashed" = "The parts and the checksum file were moved to the Trash.";
"join.partsKept" = "The parts were NOT deleted — right now they are the only intact copy.";
