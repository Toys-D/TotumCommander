"compare.help.button" = "How this works";
"compare.help.title" = "Comparing two folders";
"compare.help.intro" = "This window shows what is different between the folder in the LEFT panel and the folder in the RIGHT panel, and lets you copy files from one side to the other.";
"compare.help.what.title" = "What it compares";
"compare.help.what.body" = "The folder open in the left panel and the folder open in the right panel — including everything inside their subfolders.";
"compare.help.filter.title" = "The buttons on top";
"compare.help.filter.body" = "The list down the side chooses what is shown, and each line carries its count. “Differences” hides the files that are already the same — usually what you want. “All” shows everything, including the identical ones.";
"compare.help.content.title" = "\"Compare by content\"";
"compare.help.content.body" = "Off: files count as the same when their size AND date match. That is fast and catches most changes.\nOn: every file is read to the last byte. Slower, but it is the only way to be certain — an edit can keep both the size and the date, and only reading the contents will show it.";
"compare.help.pick.title" = "Choosing files";
"compare.help.pick.body" = "Tick the box next to a file, or click its row. \"Select all\" ticks everything currently listed — so it respects the filter above.";
"compare.help.copy.title" = "Making it happen";
"compare.help.copy.body" = "Nothing happens while you are setting arrows — the window only makes a plan. Press Synchronize when the rows say what you want. A summary appears first, listing how many files are copied, moved and deleted and where; only after you confirm does anything change on disk.";
"compare.help.folders.title" = "Why folders have no tick box";
"compare.help.folders.body" = "Folders are shown only so you can see where a file lives. The files inside them are listed separately — tick those, and the folders are created for you on the other side.";
"compare.help.safety.title" = "Is anything deleted?";
"compare.help.safety.body" = "Only if you ask for it. Copying leaves both sides intact. Moving and the bin DO remove the file — but always to the Trash, never erased, so it can be put back. Every run shows a summary first, with deletions listed last, and nothing at all happens until you confirm it. If a file already exists on the other side you are asked what to do, exactly like an ordinary copy.";
"compare.help.example.title" = "An example";
"compare.help.example.body" = "You have photos on your Mac and on a USB stick. Open the Mac folder on the left, the stick on the right, and leave the filter on “Differences”. Everything marked → exists only on the Mac; the arrows are already pointing the right way, so just press Synchronize and confirm. The stick now has them too.";
"compare.synchronize" = "Synchronize";
"compare.ignoreDate" = "Ignore date";
"compare.ignoreDate.hint" = "Compare by size alone. Useful after a copy that did not preserve timestamps.";
"compare.mask.placeholder" = "Mask, e.g. *.jpg";
"compare.column.name" = "File";
"compare.column.left" = "Left";
"compare.column.right" = "Right";
"compare.direction.hint" = "Click to change the direction: → , ← , leave alone";
"compare.resetDirections" = "Reset directions";
"compare.summary.untouched" = "%d left alone";
"compare.confirm.title" = "Synchronize folders";
"compare.confirm.toRight" = "Copy %d file(s) to “%@”";
"compare.confirm.toLeft" = "Copy %d file(s) to “%@”";
"compare.help.arrows.title" = "The arrow next to each file";
"compare.help.arrows.body" = "It shows what will happen to that file.\n→ copied to the RIGHT folder, the original stays.\n← copied to the LEFT folder, the original stays.\n🗑→ MOVED to the right: it lands on the right and is gone from the left.\n←🗑 MOVED to the left: gone from the right.\n🗑 to the Trash, on the struck-through side only.\n= left alone.\nThe bin always sits on the side that loses the file, and that side is struck through in red.\nClick the row to walk through the states, or right-click to pick one directly.\nThe program guesses first: a file on one side only travels to the other, and when both sides have it the NEWER one wins. You can always overrule it.";
"compare.help.columns.title" = "The two columns on the right";
"compare.help.columns.body" = "The size and date of the file on the left side and on the right side. The newer date is shown brighter, so you can see which copy is fresher. A dash means the file is not there at all.";
"compare.help.ignoredate.title" = "“Ignore date”";
"compare.help.ignoredate.body" = "Some ways of copying do not carry the date across, so files that are really identical look different. Turn this on and only the size is compared. (Dates within two seconds of each other already count as equal — that is as precisely as a USB stick can store them.)";
"compare.help.mask.title" = "The mask box";
"compare.help.mask.body" = "Type something like *.jpg to work with photos only. Leave it empty to see everything.";
"compare.legend.toRight" = "goes right";
"compare.legend.toLeft" = "goes left";
"compare.legend.skip" = "left alone";
"compare.legend.clickHint" = "click a row to change";
"compare.excludeMask.placeholder" = "Skip, e.g. .DS_Store;*.tmp";
"compare.excludeMask.hint" = "Files matching these masks are left out of the comparison. Separate several with a semicolon.";
"compare.menu.exclude" = "Exclude from comparison";
"compare.menu.deleteLeft" = "Move to Trash on the left";
