/* Help: working with PDFs */
"pdf.help.button" = "How to use this";
"pdf.help.make.title" = "Making a PDF out of pictures";
"pdf.help.make.body" = "Every chosen picture becomes a page, in the order of the list. This is how scans are bound: photograph ten sheets of a contract, select them in the panel, get one document.\n\nA finished PDF may go into the list too — it is taken in whole, every page of it. That is how a covering letter joins a pile of scans.";
"pdf.help.pageSize.title" = "“The picture's own size” or “A4 with margins”";
"pdf.help.pageSize.body" = "“The picture's own size” — the page is exactly the picture: nothing cropped, nothing added. Right for a document that will be read on screen.\n\n“A4 with margins” fits each picture whole onto an A4 sheet, centred, with a small margin. That is for printing: identical sheets, nothing running past the trim. A small picture is NOT stretched to fill the sheet — a stretched photograph only looks worse on paper.";
"pdf.help.order.title" = "The order";
"pdf.help.order.body" = "Files go top to bottom in the order they had in the panel. Click a row and move it with the ⌃ ⌄ arrows under the list, so the first page comes first even when its name says otherwise.";
"pdf.help.merge.title" = "Merging several PDFs";
"pdf.help.merge.body" = "The documents are joined into one, in whole, page after page. The item appears once at least two PDFs are chosen. Each name carries its page count, and the total is written below.";
"pdf.help.split.title" = "Splitting a document";
"pdf.help.split.body" = "Three ways.\n\n“Every page on its own” — thirteen pages become thirteen files.\n\n“A few pages at a time” — as many as the field says: 2 gives parts of pages 1–2, 3–4 and so on; the last part is shorter when the pages do not divide evenly.\n\n“Only the chosen pages” — one file of exactly the pages listed.\n\nThe list below always shows what will be made, before anything is pressed.";
"pdf.help.ranges.title" = "Writing page numbers";
"pdf.help.ranges.body" = "Pages are counted from one, as in the document itself.\n\n1-3 — first through third, inclusive\n7 — the seventh only\n1-3, 7, 12- — first through third, the seventh, and everything from the twelfth to the end\n-4 — from the start through the fourth\n\nAn empty field means every page. Numbers past the end are simply dropped: 3-99 in a file of five pages gives 3, 4, 5. The parts may be listed in any order — the pages are taken in the order you named them.";
"pdf.help.where.title" = "Where the result lands";
"pdf.help.where.body" = "Beside the first chosen file, with a mark in the name: “(merged)”, “(PDF)”, “— part 1”. If that name is taken, a number is added — existing files are never overwritten. The sources are left untouched.";
"pdf.help.rotate.title" = "Rotating pages";
"pdf.help.rotate.body" = "By 90° clockwise, anticlockwise, or 180°. It works on several documents at once, and the pages are counted in each separately: “3-” means one thing in a file of four pages and another in a file of forty.\n\nTurns add up: turn by 90°, then again, and it is 180°. So a scan lying upside down is put right in two presses if the first guess was wrong.";
"pdf.help.replace.title" = "A copy or a replacement";
"pdf.help.replace.body" = "By default a copy marked “(rotated)” appears beside the original, which is left as it was. The “Replace the original” switch rewrites the files in place — the button turns red then, because Cmd+Z cannot undo it.";
"pdf.help.topic" = "Working with PDFs";
"pdf.help.intro" = "Four things you can do to documents, all of them in the context menu on a file and in Tools: make a PDF out of pictures, join several PDFs into one, split a document into parts, and rotate pages. The sources are left unchanged, except where you ask for the original to be replaced.";
"pdf.name" = "File name";

