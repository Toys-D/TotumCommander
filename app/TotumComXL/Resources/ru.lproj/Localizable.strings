/* Справка по работе с PDF */
"pdf.help.button" = "Как этим пользоваться";
"pdf.help.make.title" = "Создать PDF из картинок";
"pdf.help.make.body" = "Каждая выбранная картинка становится отдельной страницей — в том порядке, что в списке. Это то, чем сшивают сканы: сфотографировали десять листов договора, выделили их в панели, получили один документ.\n\nВ список можно положить и готовый PDF: он войдёт целиком, всеми своими страницами. Так к пачке сканов подшивается сопроводительное письмо, уже сделанное в редакторе.";
"pdf.help.pageSize.title" = "«По размеру картинки» или «A4 с полями»";
"pdf.help.pageSize.body" = "«По размеру картинки» — страница ровно такая, как снимок: ничего не обрезается и не добавляется. Годится, когда документ смотрят с экрана.\n\n«A4 с полями» — каждый снимок вписывается целиком в лист A4 по центру, с небольшим отступом от края. Это для печати: одинаковые листы, ничего не уезжает за обрез. Маленькая картинка при этом НЕ растягивается на весь лист — растянутый снимок на бумаге выглядит только хуже.";
"pdf.help.order.title" = "Порядок";
"pdf.help.order.body" = "Файлы идут сверху вниз в том порядке, в каком лежали в панели. Щёлкните строку и двигайте её стрелками ⌃ ⌄ под списком — так первая страница окажется первой, даже если по имени она последняя.";
"pdf.help.merge.title" = "Объединить несколько PDF";
"pdf.help.merge.body" = "Документы склеиваются в один, целиком, страница за страницей. Пункт появляется, когда выделено хотя бы два PDF. Рядом с каждым именем написано, сколько в нём страниц, а внизу — сколько получится всего.";
"pdf.help.split.title" = "Разделить документ";
"pdf.help.split.body" = "Три способа.\n\n«Каждую страницу отдельно» — из тринадцати страниц выйдет тринадцать файлов.\n\n«По нескольку страниц» — по столько, сколько указано в поле: по 2 даст части из страниц 1–2, 3–4 и так далее; последняя часть будет короче, если страницы не поделились ровно.\n\n«Только выбранные страницы» — один файл ровно из тех страниц, что вы перечислили.\n\nСписок внизу всегда показывает, что именно получится, ещё до нажатия.";
"pdf.help.ranges.title" = "Как писать номера страниц";
"pdf.help.ranges.body" = "Страницы считаются от единицы, как в самом документе.\n\n1-3 — с первой по третью включительно\n7 — только седьмая\n1-3, 7, 12- — с первой по третью, седьмая и всё с двенадцатой до конца\n-4 — с начала по четвёртую\n\nПустое поле значит «все страницы». Номера сверх документа просто отбрасываются: 3-99 в файле из пяти страниц даст 3, 4, 5. Перечисление можно писать в любом порядке — страницы возьмутся в том, в каком вы их назвали.";
"pdf.help.where.title" = "Куда ляжет результат";
"pdf.help.where.body" = "Рядом с первым выбранным файлом, с пометкой в имени: «(объединённый)», «(PDF)», «— часть 1». Если такое имя уже занято, к нему добавится число — существующие файлы не затираются никогда. Исходные документы остаются нетронутыми.";
"pdf.help.rotate.title" = "Повернуть страницы";
"pdf.help.rotate.body" = "Поворот на 90° вправо, влево или на 180°. Работает сразу на нескольких документах, и страницы в каждом считаются отдельно: «3-» в файле из четырёх страниц и в файле из сорока значит разное.\n\nПовороты складываются: повернули на 90°, потом ещё раз — станет 180°. Так что скан, лежащий вверх ногами, доводится до нормального вида двумя нажатиями, если не угадали с первого.";
"pdf.help.replace.title" = "Копия или замена";
"pdf.help.replace.body" = "По умолчанию рядом появляется копия с пометкой «(повёрнут)», а оригинал остаётся как был. Выключатель «Заменить оригинал» перезаписывает файлы на месте — кнопка при этом становится красной, потому что Cmd+Z этого не вернёт.";
"pdf.help.topic" = "Работа с PDF";
"pdf.help.intro" = "Четыре действия над документами, все — в контекстном меню на файле и в Инструментах: собрать PDF из картинок, склеить несколько PDF в один, разделить документ на части и повернуть страницы. Исходные файлы не меняются, кроме случая, когда вы сами попросите заменить оригинал.";
"pdf.name" = "Имя файла";

